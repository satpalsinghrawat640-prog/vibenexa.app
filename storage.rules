rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all storage objects
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'satpalsinghrawat640@gmail.com';
    }

    function isValidImage() {
      return request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Public profile photos and social feed images (only if Blaze Storage is later enabled)
    match /public/avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    match /public/posts/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // Private verification proofs & payment screenshots: owner upload, Admin & owner read ONLY
    match /private/verification/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    match /private/payments/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }
  }
}
